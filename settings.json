// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "new_window",
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
  },
  "theme": "Obsidian Prism",
  "icon_theme": "Base Charmed Icons",
  "ui_font_size": 15,
  "buffer_font_size": 13,
  "tab_size": 4,
  "hard_tabs": false,
  "cursor_blink": true,
  "cursor_shape": "bar",
  "show_completions_on_input": true,
  "show_completion_documentation": true,
  "minimap": {
    "show": "always",
  },
  "title_bar": {
    "show_branch_status_icon": true,
  },
  "scrollbar": {
    "axes": {
      "horizontal": false,
      "vertical": false,
    },
  },
  "experimental.theme_overrides": {
    "players": [
      {
        "cursor": "#c8c8c8",
      },
    ],
  },
  "edit_predictions": {
    "mode": "eager",
  },
  "languages": {
    "JSON": {
      "tab_size": 2,
    },
    "JSONC": {
      "tab_size": 2,
    },
    "YAML": {
      "tab_size": 2,
    },
    "Make": {
      "hard_tabs": true,
    },
  },
  "agent": {
    "sidebar_side": "right",
    "dock": "right",
    "default_width": 375,
    "tool_permissions": {
      "tools": {
        "terminal": {
          "always_allow": [
            {
              "pattern": "^git\\s+show(\\s|$)",
            },
          ],
        },
        "mcp:mcp-server-context7:resolve-library-id": {
          "default": "allow",
        },
        "fetch": {
          "default": "allow",
        },
        "mcp:mcp-server-context7:query-docs": {
          "default": "allow",
        },
      },
    },
    "default_model": {
      "enable_thinking": false,
      "provider": "anthropic",
      "model": "claude-opus-4-8",
    },
    "thread_summary_model": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-6-1m-context-latest",
    },
  },
  "language_models": {
    "anthropic": {
      // >>> anthropic available_models — auto-generated by update-anthropic-models.py (edit MODEL_DEFAULTS, not this block) >>>
      "available_models": [
