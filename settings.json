  "notification_panel": {
    "default_width": 375,
  },
  "project_panel": {
    "dock": "left",
    "entry_spacing": "comfortable",
    "indent_size": 20,
    "default_width": 350,
  },
  "collaboration_panel": {
    "dock": "left",
    "default_width": 350,
  },
  "outline_panel": {
    "dock": "left",
    "default_width": 350,
  },
  "git_panel": {
    "dock": "left",
    "default_width": 350.0,
    "tree_view": false,
  },
  "terminal": {
    "cursor_shape": "bar",
    "blinking": "on",
    "default_height": 320,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
}
